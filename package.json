{
  "name": "green-api-max-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "tsx --tsconfig tsconfig.app.json --test src/**/*.test.ts src/**/*.test.tsx",
    "test:coverage": "c8 --reporter=text --reporter=html --check-coverage --lines 80 --functions 80 --branches 75 --statements 80 tsx --tsconfig tsconfig.app.json --test src/**/*.test.ts src/**/*.test.tsx",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "21.1.7",
    "@types/node": "18.19.130",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.13.0",
    "c8": "10.1.3",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  },
  "overrides": {
    "test-exclude": {
      "minimatch": "9.0.9"
    }
  },
  "c8": {
    "include": [
      "src/**/*.{ts,tsx}"
    ],
    "exclude": [
      "src/main.tsx",
      "src/types.ts",
      "src/test/**",
      "**/*.test.{ts,tsx}"
    ]
  }
}
